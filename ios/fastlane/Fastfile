require "base64"

default_platform(:ios)

# Build identifiers for PawVault. Signing uses a fixed Apple Distribution
# certificate + App Store provisioning profile imported into the keychain by the
# CI workflow (from secrets). This reuses one certificate across builds instead
# of creating a new one each run (which exhausts Apple's certificate limit).
APP_IDENTIFIER = "com.treamz.pawVault".freeze
TEAM_ID = "64QDKH3589".freeze
PROFILE_NAME = "PawVaultAppStore".freeze

platform :ios do
  desc "Build the signed app and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    # Write the .p8 key to disk for the App Store Connect upload (pilot).
    key_path = File.expand_path("AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false,
    )

    # Manual signing with the certificate + profile installed by the workflow.
    # The Flutter artefacts are precompiled by the workflow
    # (`flutter build ios --release --no-codesign`); this archives + signs.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: [
        "CODE_SIGN_STYLE=Manual",
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "PROVISIONING_PROFILE_SPECIFIER=#{PROFILE_NAME}",
        "CODE_SIGN_IDENTITY=Apple\\ Distribution",
      ].join(" "),
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { APP_IDENTIFIER => PROFILE_NAME },
      },
      output_directory: "build/ios/ipa",
      output_name: "PawVault.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
    )
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
  end
end
