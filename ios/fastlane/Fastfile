require "base64"
require "shellwords"

default_platform(:ios)

# Build identifiers for PawVault. These mirror ios/Runner.xcodeproj so signing
# happens with the App Store Connect API key (automatic cloud signing) — no
# certificates or provisioning profiles are stored in the repo or CI secrets.
APP_IDENTIFIER = "com.treamz.pawVault".freeze
TEAM_ID = "64QDKH3589".freeze

platform :ios do
  desc "Build the signed app and upload it to TestFlight"
  lane :beta do
    key_id = ENV.fetch("ASC_KEY_ID")
    issuer_id = ENV.fetch("ASC_ISSUER_ID")

    # Write the .p8 key to disk so xcodebuild can authenticate with App Store
    # Connect for `-allowProvisioningUpdates` (gym/build_app has no api_key
    # option, so the auth flags are passed via xcargs below). The secret holds
    # the key base64-encoded.
    key_path = File.expand_path("AuthKey_#{key_id}.p8")
    File.write(key_path, Base64.decode64(ENV.fetch("ASC_KEY_CONTENT")))

    # Same key, used by pilot for the TestFlight upload.
    api_key = app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      in_house: false,
    )

    auth_args = [
      "-allowProvisioningUpdates",
      "-authenticationKeyPath", key_path.shellescape,
      "-authenticationKeyID", key_id,
      "-authenticationKeyIssuerID", issuer_id,
    ].join(" ")

    # The Flutter artefacts are precompiled by the workflow
    # (`flutter build ios --release --no-codesign`) so this archive step reuses
    # them and only handles signing + export.
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      xcargs: auth_args,
      export_xcargs: auth_args,
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID,
      },
      output_directory: "build/ios/ipa",
      output_name: "PawVault.ipa",
      clean: true,
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      skip_waiting_for_build_processing: true,
    )
  ensure
    File.delete(key_path) if defined?(key_path) && key_path && File.exist?(key_path)
  end
end
